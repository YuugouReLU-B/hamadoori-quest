# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Tag Manager コンテナID（未設定ならGTMは読み込まれない）
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000

# 開発時は空でもかまいません
NEXT_PUBLIC_SENTRY_DSN=your-project-dsn
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

ENABLE_CONFIRMATIONS=true

# 現在 supabase/config.toml の [auth.email.smtp] はコメントアウトしてあり、
# これらの値はどこからも読まれない（本番もSupabase標準の送信に任せている）。
# 独自SMTPを使うことになったら config.toml のブロックを戻してから設定する。
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_USER=example@mailgun.org
SMTP_PASS=password
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME=test_sender

# Mailgun
MAILGUN_API_KEY=mailgun-api-key
MAILGUN_DOMAIN=team-mir.ai

# バッチ処理API用の管理者キー（本番環境では強力なランダム文字列を設定）
BATCH_ADMIN_KEY=development-admin-key-2025

# MCPサーバー（/api/mcp）の認証トークン（本番環境では強力なランダム文字列を設定）
MCP_API_KEY=development-mcp-key-2026

# LINE Login credentials (Get from LINE Developers Console)
LINE_CLIENT_SECRET=your-line-channel-secret
NEXT_PUBLIC_LINE_CLIENT_ID=your-line-channel-id

# 認証フロー中に公式アカウントの友だち追加を促す（aggressive / normal / 未設定）
# LINEログインチャネルに公式アカウントがリンクされていないと機能しないため、
# リンクが済むまでは未設定にしておくこと
NEXT_PUBLIC_LINE_BOT_PROMPT=

# 累計ポイント到達ユーザーをLINEオーディエンスへ追加するための設定（Messaging API）
# 未設定の場合、この機能は何もしない
# LINE_CHANNEL_ACCESS_TOKEN: LINE Developersコンソールで発行するチャネルアクセストークン（長期）
# LINE_MILESTONE_AUDIENCE_GROUP_ID: 事前にAPIで作成した「ユーザーID追加型」オーディエンスグループのID
LINE_CHANNEL_ACCESS_TOKEN=
LINE_MILESTONE_AUDIENCE_GROUP_ID=

# データ基盤用
BQ_USER_PASSWORD=bq-password

# 抽選応募トークンの生成用シークレット（本番環境では強力なランダム文字列を設定）
# しきい値ポイント・見出し・応募フォームURL等は lottery_settings テーブル（/admin/lottery）で管理する
LOTTERY_TOKEN_SECRET=development-lottery-secret-2026

# ベータ公開前のサイト全体のBasic認証。
# 両方セットしたときだけ有効になる。未設定ならローカル開発は素通し。
# 公開時はこの2つを消す（Vercel側の環境変数も忘れずに）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
