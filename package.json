{
  "name": "hamadori-quest",
  "version": "0.1.0",
  "description": "浜通りクエスト",
  "license": "AGPL-3.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "types": "npx supabase@2.105.0 gen types typescript --local > src/lib/types/supabase.ts && biome check --write src/lib/types/supabase.ts",
    "db:migrate": "npx supabase@2.105.0 migration up --local && pnpm run types",
    "db:reset": "npx supabase@2.105.0 db reset && pnpm run types && pnpm run mission:sync && pnpm run seed:after-sync",
    "seed:after-sync": "./scripts/seed-after-sync.sh",
    "biome:check:write": "biome check --write .",
    "test": "pnpm run test:unit && pnpm run test:supabase && pnpm run test:e2e",
    "test:ci:unit": "jest --ci --reporters=default --reporters=jest-junit --testPathIgnorePatterns='tests/supabase/' --testPathIgnorePatterns='tests/integration/'",
    "test:ci:supabase": "jest --ci --reporters=default --reporters=jest-junit --testMatch='**/tests/supabase/**/*.test.ts' --testEnvironment=node --coverage=false",
    "test:ci:playwright": "CI=true playwright test",
    "test:ci:integration": "jest --ci --passWithNoTests --reporters=default --reporters=jest-junit --testMatch='**/tests/integration/**/*.test.ts' --testEnvironment=node --coverageDirectory='./coverage-integration'",
    "test:ci:e2e": "pnpm run test:ci:playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:unit": "jest --testPathIgnorePatterns='tests/supabase/' --testPathIgnorePatterns='tests/integration/'",
    "test:supabase": "jest --testMatch='**/tests/supabase/**/*.test.ts' --testEnvironment=node --coverage=false",
    "test:integration": "jest --passWithNoTests --testMatch='**/tests/integration/**/*.test.ts' --testEnvironment=node --coverage=false",
    "typecheck": "tsc --noEmit",
    "mission:sync": "tsx mission_data/src/sync.ts",
    "mission:sync:dry": "tsx mission_data/src/sync.ts --dry-run",
    "mission:export": "tsx mission_data/src/export.ts",
    "season:sync": "tsx season_data/src/sync.ts",
    "season:sync:dry": "tsx season_data/src/sync.ts --dry-run"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.49.8",
    "@turf/area": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^11.1.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "js-yaml": "^4.3.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.16",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.66.7",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^16.0.0",
    "lefthook": "^1.13.6",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "jest-junit": {
    "outputDirectory": "./jest-report",
    "outputName": "junit.xml"
  }
}
